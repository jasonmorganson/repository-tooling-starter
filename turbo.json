{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "mise.toml",
    ".config/mise/**/*.toml",
    ".config/fnox/**/*.toml",
    ".config/hk.pkl",
    ".config/pitchfork.toml",
    ".config/wt.toml"
  ],
  "globalPassThroughEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"] },
    "check": { "dependsOn": ["^check"] },
    "test": { "dependsOn": ["^test"] },
    "lint": { "dependsOn": ["^lint"] },
    "dev": { "cache": false, "persistent": true }
  }
}
