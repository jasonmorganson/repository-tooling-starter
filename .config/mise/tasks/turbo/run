#!/usr/bin/env nu
#MISE description="Run one Turbo task when this repository defines a JavaScript workspace"
#MISE tools."aqua:nushell/nushell"="latest"

def main [task: string] {
  if ($task | is-empty) {
    error make { msg: "A Turbo task name is required." }
  }

  if not ("package.json" | path exists) {
    print $"Skipping turbo ($task): no package.json has been added yet."
    return
  }

  ^mise exec -- turbo run $task
}
