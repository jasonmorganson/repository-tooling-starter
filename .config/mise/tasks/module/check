#!/usr/bin/env nu
#MISE description="Validate copy-only configuration modules and negative fixtures"
#MISE tools={"aqua:nushell/nushell"="latest"}

def fail [message: string] { error make { msg: $message } }
def require-file [file: string] { if not ($file | path exists) { fail $"Missing required file: ($file)" } }

def no-secret-literals [root: string] {
  let findings = (
    glob $"($root)/**/*"
    | where {|file| ($file | path type) == "file" }
    | each {|file| open --raw $file | lines | where {|line| $line =~ '(?i)^\s*[A-Z][A-Z0-9_]*(TOKEN|SECRET|PASSWORD|API_KEY|PRIVATE_KEY)\s*=\s*"[^"].*"\s*$' }}
    | flatten
  )
  if not ($findings | is-empty) { fail $"Secret-like literal found in ($root)" }
}

def validate-module [root: string, expected_name: string] {
  require-file $"($root)/module.toml"
  require-file $"($root)/README.md"
  if not ($"($root)/files" | path exists) { fail $"Missing files directory: ($root)" }
  let manifest = open $"($root)/module.toml"
  if $manifest.module.name != $expected_name { fail $"Unexpected module name in ($root)" }
  if ($manifest.module.copy_mode? | default "") != "copy" { fail $"Module is not copy-only: ($expected_name)" }
  if not ($manifest.module.required_inputs? | describe | str contains "list") { fail $"Missing required_inputs list: ($expected_name)" }
  if not ($manifest.module.validation? | describe | str contains "list") { fail $"Missing validation list: ($expected_name)" }
  if $expected_name == "turbo-monorepo" and not ($manifest.module.cache_env_review? | default false) { fail "Turbo module must require cache environment review" }
  no-secret-literals $"($root)/files"
}

def validate-fixture [fixture: string] {
  let kind = (open $"($fixture)/fixture.toml").fixture.kind
  match $kind {
    "both-dependency-bots" => {
      let selected = (open $"($fixture)/selected-modules.toml").modules.selected
      if (($selected | any {|name| $name == "dependency-updates/dependabot" }) and ($selected | any {|name| $name == "dependency-updates/renovate" })) { fail "Dependabot and Renovate cannot be selected together" }
    }
    "inline-toml-task" => { if (open --raw $"($fixture)/config.toml" | lines | any {|line| $line =~ '^\[tasks(\.|\])' }) { fail "Inline TOML task fixture was accepted" } }
    "missing-readme" => { require-file $"($fixture)/module/README.md" }
    "undeclared-cache-env" => { if not ((open $"($fixture)/module.toml").module.cache_env_review? | default false) { fail "Cache environment review is required" } }
    "secret-literal" => { no-secret-literals $fixture }
    _ => { fail $"Unknown fixture kind: ($kind)" }
  }
}

let modules = ["hk-javascript" "turbo-monorepo" "service-worktree" "github-actions-quality" "dependency-updates/dependabot" "dependency-updates/renovate"]
for name in $modules { validate-module $"modules/($name)" $name }

let dependabot = open "modules/dependency-updates/dependabot/module.toml"
let renovate = open "modules/dependency-updates/renovate/module.toml"
if not (($dependabot.module.conflicts | any {|name| $name == "dependency-updates/renovate" }) and ($renovate.module.conflicts | any {|name| $name == "dependency-updates/dependabot" })) { fail "Dependency module conflicts must be reciprocal" }

for fixture in (glob "modules/fixtures/negative/*" | where {|path| ($path | path type) == "dir" }) {
  let result = try { validate-fixture $fixture; "accepted" } catch { "rejected" }
  if $result != "rejected" { fail $"Negative fixture was accepted: ($fixture)" }
}

print "Repository tooling modules are valid."
