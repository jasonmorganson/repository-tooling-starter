#!/usr/bin/env bash
#MISE description="Validate the reusable tooling starter contract"
set -euo pipefail

for file in mise.toml .config/mise/config.toml .config/fnox/local.toml .config/hk.pkl .config/pitchfork.toml .config/wt.toml turbo.json .github/workflows/ci.yml; do
  [[ -f "$file" ]] || { echo "Missing required template file: $file" >&2; exit 1; }
done

for task in setup start stop format lint test build ci; do
  [[ -x ".config/mise/tasks/$task" ]] || { echo "Missing executable canonical mise task: $task" >&2; exit 1; }
done

for task in check/_default app/serve turbo/run check/template; do
  [[ -x ".config/mise/tasks/$task" ]] || { echo "Missing executable extension mise task: $task" >&2; exit 1; }
done

! grep -Eq '^\[tasks(\.|\])' .config/mise/config.toml || {
  echo "Define starter behavior in native mise file tasks, not inline TOML tasks." >&2
  exit 1
}

grep -Fq 'default_branch = "origin/main"' .config/hk.pkl
grep -Fq 'mise run check:template' .config/hk.pkl
grep -Fq 'type = "plain"' .config/fnox/local.toml
grep -Fq 'fnox -c .config/fnox/local.toml' .config/pitchfork.toml
grep -Fq 'port-base=' .config/wt.toml
grep -Fq 'hash_port' .config/wt.toml
grep -Fq '"cache": false, "persistent": true' turbo.json
grep -Fq 'CI_BASE_SHA' .github/workflows/ci.yml
grep -Fq -- '--from-ref' .config/mise/tasks/ci

if grep -En '^\s*[A-Z][A-Z0-9_]*\s*=\s*"[^"].*"\s*$' .config/fnox/*.toml | grep -Ev 'provider\s*=|description\s*='; then
  echo "fnox config must declare secret sources, not secret values." >&2
  exit 1
fi

echo "Repository tooling starter contract is valid."
