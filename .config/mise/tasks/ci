#!/usr/bin/env nu
#MISE description="Run exact-range hook checks, then canonical test and build tasks"
#MISE depends=["check:template"]
#MISE tools={"aqua:nushell/nushell"="latest"}

let base_sha = ($env.CI_BASE_SHA? | default "")
let head_sha = ($env.CI_HEAD_SHA? | default "")

if (($base_sha | is-not-empty) and $base_sha != "0000000000000000000000000000000000000000" and ($head_sha | is-not-empty)) {
  ^mise exec -- hk check --from-ref $base_sha --to-ref $head_sha
} else {
  ^mise exec -- hk check --all
}

^mise run test
^mise run build
